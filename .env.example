# GRANDSTAY - ỨNG DỤNG QUẢN LÝ KHÁCH SẠN TKINTER MVC
# Tạo CSDL (MySQL Workbench):
# CREATE DATABASE IF NOT EXISTS grandstay_nhom11 CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

# KẾT NỐI MYSQL - KHÔNG cần DATABASE_URL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=grandstay_nhom11

# Đặt MYSQL_PASSWORD bằng mật khẩu thật nếu MySQL có mật khẩu.
# Các ký tự đặc biệt (@, #, :, /, %) trong mật khẩu được xử lý tự động.
# Nên dùng user MySQL riêng thay cho root khi triển khai chính thức.

HOTEL_NAME=GrandStay

# Tài khoản Admin được tạo bằng: python -m scripts.create_admin
# ADMIN_USERNAME và ADMIN_PASSWORD không tự tạo tài khoản trong bản này.

# Chưa kích hoạt gửi email tự động hoặc chatbot dùng Gemini trong bản Tkinter.
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
# EMAIL_FROM=
# GEMINI_API_KEY=
# GEMINI_MODEL=

# Tương thích ngược: có thể dùng DATABASE_URL thay cho MYSQL_*,
# nhưng không cần khai báo cả hai. Nếu có cả hai, MYSQL_* được ưu tiên.
