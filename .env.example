# GRANDSTAY - ỨNG DỤNG QUẢN LÝ KHÁCH SẠN TKINTER MVC
# Tạo CSDL (MySQL Workbench):
# CREATE DATABASE IF NOT EXISTS grandstay_nhom11 CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

# KẾT NỐI MYSQL - KHÔNG cần DATABASE_URL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=grandstay_nhom11

# Đặt MYSQL_PASSWORD bằng mật khẩu thật nếu MySQL có mật khẩu.
# Các ký tự đặc biệt (@, #, :, /, %) trong mật khẩu được xử lý tự động.
# Nên dùng user MySQL riêng thay cho root khi triển khai chính thức.

HOTEL_NAME=GrandStay

# Tài khoản Admin được tạo bằng: python -m scripts.create_admin
# ADMIN_USERNAME và ADMIN_PASSWORD không tự tạo tài khoản trong bản này.

# GỬI EMAIL OTP - Điền thông tin SMTP thật trước khi dùng đăng ký/khôi phục.
# Gmail: dùng mật khẩu ứng dụng (App Password), KHÔNG nhập mật khẩu Gmail chính.
# Chỉ truyền thông tin qua SMTP được mã hóa STARTTLS hoặc SSL.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURITY=starttls
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=

# Khóa HMAC bảo vệ OTP trong cơ sở dữ liệu. Tạo bằng:
# py -c "import secrets; print(secrets.token_hex(32))"
# Nếu để trống, ứng dụng dùng khóa ngẫu nhiên theo phiên và OTP cũ hết hiệu lực
# sau khi khởi động lại. Nên đặt giá trị cố định, bí mật cho triển khai thực tế.
EMAIL_OTP_SECRET=

# Chưa kích hoạt chatbot Gemini trong bản Tkinter.
# GEMINI_API_KEY=
# GEMINI_MODEL=

# Tương thích ngược: có thể dùng DATABASE_URL thay cho MYSQL_*,
# nhưng không cần khai báo cả hai. Nếu có cả hai, MYSQL_* được ưu tiên.
